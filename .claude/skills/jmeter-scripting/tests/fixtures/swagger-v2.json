{
  "swagger": "2.0",
  "info": { "title": "Demo Shop API", "version": "1.0" },
  "host": "docs.internal.example.com",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "用户登录",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/LoginReq" }
          }
        ]
      }
    },
    "/products": {
      "get": {
        "summary": "商品列表",
        "parameters": [
          { "in": "query", "name": "page", "type": "integer", "default": 1 },
          { "in": "query", "name": "size", "type": "integer", "default": 20 }
        ]
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "商品详情",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" }
        ]
      }
    },
    "/orders": {
      "post": {
        "summary": "创建订单",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Result%C2%ABOrderReq%C2%BB" }
          }
        ]
      }
    }
  },
  "definitions": {
    "LoginReq": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "Result«OrderReq»": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "qty": { "type": "integer" },
        "remark": { "type": "string" }
      }
    }
  }
}
