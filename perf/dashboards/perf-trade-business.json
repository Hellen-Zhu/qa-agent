    {
      "id": 8,
      "type": "timeseries",
      "title": "Load Delivery: RPS vs dropped",
      "description": "dropped/s > 0 means the load generator cannot sustain the target rate (maxVUs too low / generator bottleneck) — the delivered rate is distorted and every conclusion of this run is discounted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
