{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus instance k6 remote write pushes to",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
