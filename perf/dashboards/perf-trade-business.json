    {
      "id": 17,
      "type": "timeseries",
      "title": "Load / Throughput / Response Time (over time)",
      "description": "Capacity analysis — only meaningful for ladder/stress runs (load ramps within the run). Knee point: RPS plateaus while VUs keep climbing and p95 takes off. In ladder runs load ramps monotonically, so the time axis doubles as the load axis.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_vus{testid=~\"$testid\"})",
          "refId": "A",
          "legendFormat": "VUs (load)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "RPS (throughput)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(k6_perf_success_duration_p95{testid=~\"$testid\"})",
          "refId": "C",
          "legendFormat": "success p95 (response time)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success p95 (response time)"
