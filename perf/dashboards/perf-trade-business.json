{
  "title": "Perf - Trade Overview",
  "uid": "perf-trade-biz",
  "schemaVersion": 39,
  "tags": ["perf", "k6"],
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    {
      "type": "link",
      "title": "官方 k6 总览 (19665)",
      "url": "/d/ccbb2351-2ae2-462f-ae0e-f2c893ad1028",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "testid",
        "type": "query",
        "query": "label_values(k6_http_reqs_total, testid)",
        "refresh": 2,
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "title": "requests per second (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\"}[1m]))", "legendFormat": "RPS" }
      ]
    },
    {
      "title": "virtual users (VUs)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "k6_vus{testid=\"$testid\"}", "legendFormat": "VUs" }
      ]
    },
    {
      "title": "HTTP duration p95/p99 (ms) — 全请求含失败",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "k6_http_req_duration_p95{testid=\"$testid\"}", "legendFormat": "p95" },
        { "expr": "k6_http_req_duration_p99{testid=\"$testid\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "HTTP failed rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "k6_http_req_failed_rate{testid=\"$testid\"}", "legendFormat": "failed rate" }
      ]
    },
    {
      "title": "success-only duration p95/p99 (ms) — SLA 观测对象",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "k6_perf_success_duration_p95{testid=\"$testid\"}", "legendFormat": "p95" },
        { "expr": "k6_perf_success_duration_p99{testid=\"$testid\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "errors per second by class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(k6_perf_err_technical_total{testid=\"$testid\"}[1m])", "legendFormat": "technical" },
        { "expr": "rate(k6_perf_err_business_total{testid=\"$testid\"}[1m])", "legendFormat": "business" },
        { "expr": "rate(k6_perf_err_script_total{testid=\"$testid\"}[1m])", "legendFormat": "script" }
      ]
    },
    {
      "title": "business success rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "k6_perf_business_success_rate{testid=\"$testid\"}", "legendFormat": "success rate" }
      ]
    },
    {
      "title": "business errors by data row (数据坏行定位)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum by (row, reason) (rate(k6_perf_err_business_total{testid=\"$testid\"}[1m]))", "legendFormat": "row {{row}} {{reason}}" }
      ]
    }
  ]
}
