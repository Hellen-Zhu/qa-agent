    {
      "id": 10,
      "type": "timeseries",
      "title": "Load Delivery: RPS vs dropped",
      "description": "dropped/s > 0 means the load generator cannot sustain the target rate (maxVUs too low / generator bottleneck) — the delivered rate is distorted and every conclusion is discounted.",
