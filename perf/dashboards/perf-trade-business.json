    {
      "id": 20,
      "type": "table",
      "title": "Run History (per testid)",
      "description": "Leader view: one row per run — Total/Success/Success Rate are exact caliber; p95 is a window-average approximation (trend direction only — exact percentiles live in summary). Use with testid=All and a wide time range to read regression direction across runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (testid)(max_over_time(k6_http_reqs_total{testid=~\"$testid\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (testid)(max_over_time(k6_perf_ok_total{testid=~\"$testid\"}[$__range]))",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (testid)(max_over_time(k6_perf_ok_total{testid=~\"$testid\"}[$__range])) / sum by (testid)(max_over_time(k6_http_reqs_total{testid=~\"$testid\"}[$__range]))",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg by (testid)(avg_over_time(k6_perf_success_duration_p95{testid=~\"$testid\"}[$__range]))",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "testid",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "Value #A": "Total",
              "Value #B": "Success",
              "Value #C": "Success Rate",
              "Value #D": "p95 approx"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "testid",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success Rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 approx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Server Utilization / Saturation",
      "description": "Capacity's missing lines — same time window as the load curves above. cpu = jvm_cpu_recent_utilization_ratio (process view, Utilization; red line 90%); db-pending = HikariCP pending connections (Saturation — queueing starts before CPU tops out). The resource that climbs first at the knee is the bottleneck suspect. Server caliber: 30s scrape, not k6 5s push.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "jvm_cpu_recent_utilization_ratio{service_name=~\"$service\"}",
          "refId": "A",
          "legendFormat": "cpu {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "hikaricp_connections_pending{service_name=~\"$service\"}",
          "refId": "B",
          "legendFormat": "db-pending {{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0,
            "axisSoftMax": 1,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
