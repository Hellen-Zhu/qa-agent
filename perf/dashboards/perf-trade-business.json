{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus instance k6 remote write pushes to",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Perf - Trade Overview",
  "uid": "perf-trade-biz",
  "description": "Persona-layered: reconciliation (exact = summary) → live → load delivery → response time trend → attribution → capacity analysis → run history. Authoritative numbers come from summary; the verdict comes from thresholds.",
  "schemaVersion": 39,
  "tags": [
    "k6",
    "perf"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Official k6 Overview (19665)",
      "url": "/d/ccbb2351-2ae2-462f-ae0e-f2c893ad1028",
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "Server Metrics (backend)",
      "tooltip": "Backend service dashboard — replace TBC uid at import; keepTime carries the test window over",
      "url": "/d/TBC-SERVER-DASHBOARD-UID",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "query": "label_values(k6_http_reqs_total, testid)",
        "regex": "/^[^_]+_([^_]+)_[^_]+_/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        }
      },
      {
        "name": "profile",
        "label": "profile",
        "type": "query",
        "query": "label_values(k6_http_reqs_total, testid)",
        "regex": "/^[^_]+_[^_]+_([^_]+)_/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        }
      },
      {
        "name": "testid",
        "type": "query",
        "query": "label_values(k6_http_reqs_total{testid=~\"^[^_]+_(${env:regex})_(${profile:regex})_.*\"}, testid)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        }
      },
      {
        "name": "service",
        "type": "query",
        "query": "label_values(jvm_cpu_recent_utilization_ratio, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests",
      "description": "Exact caliber: counter final value via max_over_time — must match this run's summary line by line.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max_over_time(k6_http_reqs_total{testid=~\"$testid\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success",
      "description": "Exact caliber: counter final value via max_over_time — must match this run's summary line by line.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(max_over_time(k6_perf_ok_total{testid=~\"$testid\"}[$__range])) or vector(0))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request Failures",
      "description": "Exact caliber: counter final value via max_over_time — must match this run's summary line by line. Technical = THE performance conclusion; business = usually a data problem; script > 0 voids the run.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max_over_time(k6_perf_err_technical_total{testid=~\"$testid\"}[$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "technical",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max_over_time(k6_perf_err_business_total{testid=~\"$testid\"}[$__range])) or vector(0)",
          "refId": "B",
          "legendFormat": "business",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max_over_time(k6_perf_err_script_total{testid=~\"$testid\"}[$__range])) or vector(0)",
          "refId": "C",
          "legendFormat": "script",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "business"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Success Rate",
      "description": "Exact caliber: counter final value via max_over_time — must match this run's summary line by line. Computed from counters — more exact than the windowed rate metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(max_over_time(k6_perf_ok_total{testid=~\"$testid\"}[$__range])) or vector(0)) / sum(max_over_time(k6_http_reqs_total{testid=~\"$testid\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Performance Overview",
      "description": "One-glance run shape (19665-style, business caliber). Trend caliber: 5s push windows — authoritative numbers live in summary. Validity signals folded in: dropped/s > 0 = generator cannot sustain target rate (conclusions discounted); vus touching maxVUs cap = early warning of rate distortion. http errors/s is HTTP caliber (expected_response=false); sparse errors may not render — exact counts live in Failure Attribution.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_vus{testid=~\"$testid\"})",
          "refId": "A",
          "legendFormat": "vus"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_vus_max{testid=~\"$testid\"})",
          "refId": "B",
          "legendFormat": "maxVUs cap"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "rps"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(k6_perf_success_duration_p95{testid=~\"$testid\"})",
          "refId": "D",
          "legendFormat": "success p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_dropped_iterations_total{testid=~\"$testid\"}[$__rate_interval]))",
          "refId": "E",
          "legendFormat": "dropped/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\", expected_response=\"false\"}[$__rate_interval]))",
          "refId": "F",
          "legendFormat": "http errors/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vus"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "maxVUs cap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-gray",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dropped/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http errors/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Peak RPS",
      "description": "Peak of the instantaneous window rate (irate, 19665 caliber) — trend approximation, no summary counterpart (summary reports whole-run averages). Read against the profile's target rate: peak far above target = bursty delivery; ladder runs: top-step ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(irate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "peak rps"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "max"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "fixedColor": "yellow",
            "mode": "fixed"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Success Duration Percentiles (per API)",
      "description": "Trend caliber (5s push windows) — answers when/shape only; authoritative numbers live in summary. SLA source (business-successful samples only). Red line = SLA reference (placeholder 300 ms — sync manually with config/slas after calibration). p95/p50 divergence marks slow-path onset.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "k6_perf_success_duration_p50{testid=~\"$testid\"}",
          "refId": "A",
          "legendFormat": "{{name}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "k6_perf_success_duration_p95{testid=~\"$testid\"}",
          "refId": "B",
          "legendFormat": "{{name}} p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "k6_perf_success_duration_p99{testid=~\"$testid\"}",
          "refId": "C",
          "legendFormat": "{{name}} p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Failure Attribution (by reason)",
      "description": "Exact caliber: counter final value via max_over_time — must match this run's summary totals. Top 10 per class (long tail: result.csv / k6.log). technical: net-* = timeout/connect, http-5xx = server error, http-409 → suspect identity-pool misconfig first; business row-level detail lives in summary/k6.log/result.csv.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (reason)(max_over_time(k6_perf_err_technical_total{testid=~\"$testid\"}[$__range])))",
          "refId": "A",
          "legendFormat": "technical · {{reason}}",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (reason)(max_over_time(k6_perf_err_business_total{testid=~\"$testid\"}[$__range])))",
          "refId": "B",
          "legendFormat": "business · {{reason}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "business.*"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Errors Over Time (cumulative)",
      "description": "Cumulative counters: step onset = when errors began, step height = running total. Renders even for a single sparse error (a rate curve cannot — it needs ≥2 samples per window).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_perf_err_technical_total{testid=~\"$testid\"})",
          "refId": "A",
          "legendFormat": "technical"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_perf_err_business_total{testid=~\"$testid\"})",
          "refId": "B",
          "legendFormat": "business"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(k6_perf_err_script_total{testid=~\"$testid\"})",
          "refId": "C",
          "legendFormat": "script"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
