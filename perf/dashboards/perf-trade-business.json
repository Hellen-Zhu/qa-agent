        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(max_over_time(k6_perf_ok_total{testid=~\"$testid\"}[$__range])) or vector(0)) / sum(max_over_time(k6_http_reqs_total{testid=~\"$testid\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
