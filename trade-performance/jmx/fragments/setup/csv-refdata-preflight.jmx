<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/setup/csv-refdata-preflight.jmx

  【层级】组合 fragment —— 只 Include 原子 fragment，自己不定义任何 sampler（校验规则 R1/R2）
  【被谁引用】api/p02-trade-create.jmx 的 setUp Thread Group
  【职责】静态 refdata 模式（refdataSource=csv）下的开跑前守卫

  ══ 与 setup/refdata-preflight.jmx 的关系（两个都要留着）═══════════
    refdata-preflight       动态模式。查 GET /refdata/* → 建全局池 → 前置校验 → 归档快照
                            被 s01（E2E）使用，那里 refdata 查询本身就是被测链路
    本文件                  静态模式。CSV 已经供数，**没有 refdata 查询**
                            被 p02（单接口）使用

  两者的第 3 步（真实建一笔 trade）完全相同，且 Include 的是同一份
  create 原子 fragment，连断言脚本 preflight-policy.groovy 都共用。
  差异只在于**前两步存不存在**。
  ═══════════════════════════════════════════════════════════════

  ══ 为什么静态化之后 preflight create 反而更重要 ═══════════════════
  动态模式下失效数据在 setUp 查询时就查不出来，立刻暴露。
  静态模式没有那次查询 —— CSV 里的 id 若已在库中失效（counterparty 被第三方停用、
  portfolio 被归档），请求照发，服务端返回业务拒绝。
  报告里表现为"错误率升高"而不是"启动失败"，会被误读成性能问题。

  所以这一步不是可选的加固，是静态模式**唯一**的数据有效性证明。
  一行 CSV 证明不了任何事，只有真发一笔 create 才行。
  ═══════════════════════════════════════════════════════════════

  【输入变量】portfolioId / counterpartyFmId / counterpartyName —— 由调用方的
             CSV Data Set 提供（p02 的 "csv: refdata pairs"）
  【输出属性】refdataPoolError    CSV 不可用时的原因描述（正常时不存在）
             preflightOutcome    warn | abort（由 preflight-policy.groovy 写）
  【产出事务】TX_workers_trademgmt_create（runPhase=setup，结果分析时须过滤）
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="csv-refdata-preflight (composite fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Composite fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="csv-refdata-preflight" enabled="true"/>
      <hashTree>

        <!-- ── 1. 本地检查：CSV 填了没 ──────────────────────────────
             不发请求。占位值 / 列名对不上会在这里直接停测，
             省掉一次注定失败的 create，也省掉一份错误率 100% 的报告。 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="validate csv refdata" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__P(baseDir,.)}/groovy/validate-csv-refdata.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- ── 2. 远端检查：填的值今天还能用吗 ──────────────────────
             Include 的是主链路用的同一份 create 原子 fragment，
             差异只在于外层多挂 preflight-policy 断言（与动态模式共用同一个脚本）。 -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="preflight create" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include create-trade" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/create-trade.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="preflight policy" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/preflight-policy.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
