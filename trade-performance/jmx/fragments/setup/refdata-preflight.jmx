<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/setup/refdata-preflight.jmx

  【层级】组合 fragment —— 只 Include 原子 fragment，自己不定义任何 sampler（校验规则 R1/R2）
  【被谁引用】scenarios/s01-create-trade-e2e.jmx、api/p02-trade-create.jmx 的 setUp Thread Group
  【职责】解析参考数据池 → 前置校验 → 归档快照

  ══ 本文件曾是"每个 API 只维护一份"被破坏的地方 ═══════════════════
  重构前它自己写了三个 sampler：portfolios、counterparties、create ——
  与 steps/ 下的定义完全重复。后端给 create 加一个必填字段，要改两处，
  而没有任何东西会提醒第二处存在。
  现在它一个 sampler 都不定义，只 Include 三个原子 fragment，
  差异通过"外层挂什么 PostProcessor / Assertion"表达。校验规则 R2 保证复制进不来。
  ═══════════════════════════════════════════════════════════════

  ── 为什么放在 setUp Thread Group 而不是主循环 ──
  Counterparty / Portfolio 由 sync batch job 从第三方同步进我们的数据库，属于
  **测试无法控制的外部状态**。硬编码会过期；放进主循环又会把 refdata 的耗时
  混进被测值、并给 DB 加额外负载。
  setUp 是唯一同时满足"新鲜"和"不在测量窗口内"的位置。

  ⚠ 本 fragment 产生的样本会进入 jtl，且事务名与主链路相同
    （因为 Include 的是同一份原子 fragment）。结果分析时用 **runPhase=setup**
    这一列过滤掉它们 —— setUp Thread Group 的 UDV 会把 runPhase 设为 setup，
    主 Thread Group 设为 main。不过滤会让 preflight 的那一笔 create 混进容量统计。

  【输出属性（全局，跨线程组可见）】
    perfPortfolios      JSON 数组
    perfCounterparties  JSON 数组 [{fmId, name}, ...]
    refdataPoolError    池过小时的分段错误描述（正常时不存在）
    preflightOutcome    abort | warn | pruned:N
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="refdata-preflight (composite fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Composite fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="refdata-preflight" enabled="true"/>
      <hashTree>

        <!-- ── 1. 查 Portfolio → 建全局池 ──────────────────────────── -->
        <!-- Simple Controller 限定 PostProcessor 的作用域，见 _composites/refdata-load.jmx 的说明 -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="portfolios" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include portfolios-list" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/refdata/portfolios-list.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="build portfolio pool" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/refdata-pool-portfolios.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <!-- ── 2. 查 Counterparty → 建全局池 ───────────────────────── -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="counterparties" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include counterparties-list" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/refdata/counterparties-list.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="build counterparty pool" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/refdata-pool-counterparties.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <!-- ── 3. 前置校验：真实建一笔 trade ───────────────────────── -->
        <!-- 只有这一步能发现"数据存在但业务上不可用"（如 counterparty 已被第三方停用）。
             refdata 查询返回 200 证明不了这件事。

             Include 的是主链路用的同一份 create 原子 fragment ——
             差异只在于外层多挂一个 preflight-policy 断言。
             datFile 由 create fragment 内的 resolve-dat-file.groovy 解析：
             setUp 没有 CSV，它会回退到属性 preflightDatFile。 -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="preflight create" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include create-trade" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/create-trade.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="preflight policy" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/preflight-policy.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

        <!-- ── 4. 归档快照 ─────────────────────────────────────────── -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="archive refdata snapshot" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__P(baseDir,.)}/groovy/archive-refdata-snapshot.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
