<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/steps/_composites/refdata-load.jmx

  【层级】组合 fragment —— 只 Include 原子 fragment，自己不定义任何 sampler（校验规则 R1/R2）
  【职责】模拟前端打开 create-trade 页面时拉取两个下拉框的数据。
  【被谁引用】journeys/j01-create-trade.jmx

  ══ 为什么 _composites 目录不按 svc 分 ═══════════════════════════
  原子 fragment 按 svc/module 组织（镜像系统架构，对应代码归属）；
  组合按**业务动作**组织（可能横跨多个 svc）。两套分类法不能合并成一棵树——
  强行合并的结果就是有人开始复制 fragment。
  本文件恰好只用到 refdata 一个服务，但 view-trade-details 就横跨 workers 与 risk-engine。
  ═══════════════════════════════════════════════════════════════

  ── 与 fragments/setup/refdata-preflight.jmx 的区别（重要，别搞混）──
  setup/refdata-preflight  在 setUp Thread Group，跑一次，**不计入测量**（runPhase=setup）。
                            目的是"确认数据可用"和"给单接口测试供数"。
  本文件                    在主循环，每次迭代都跑，**计入测量**（runPhase=main）。
                            目的是"复现真实前端行为"——用户每开一次页面就查一次，
                            这些查询对 DB 的负载是生产中真实存在的。
  单接口容量测试不能用本文件：refdata 的耗时会混进被测值。

  **两者 Include 的是同一份原子 fragment**，差异只在于外层挂哪个 PostProcessor：
  这里挂 pick（随机取一条当入参），preflight 挂 pool（取全部建全局池）。
  这就是"一个 API 只维护一份"的具体落地方式。

  ══ Fragment 契约 ══════════════════════════════════════════════
  【输入变量】userId 必填
  【输出变量】portfolioId / counterpartyFmId / counterpartyName
             refdataBound=true → 告诉 create 不要再从全局池挑
  【产出事务】TX_flow_refdata_load（内含 TX_refdata_portfolios_list、TX_refdata_counterparties_list）
  ═══════════════════════════════════════════════════════════════

  ⚠ 统计口径：TX_flow_* 是组合事务，包含其内部的 TX_<svc>_* 原子事务。
    计算 TPS 时**二选一**，不可相加，否则同一次工作被计两次。见 KPI Definitions §2.7。

  两个查询用 Parallel Controller 会更贴近浏览器行为（前端通常并发拉取），
  但那需要 bzm - Parallel Controller 插件。当前用串行，属已知偏差：
  会让 TX_flow_refdata_load 比真实前端慢（约等于两者之和而非最大值）。
  上插件后改本文件一处即可，原子 fragment 与 journey 都无需改动。
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="refdata-load (composite fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Composite fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="refdata-load" enabled="true"/>
      <hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_flow_refdata_load" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <!-- Simple Controller 在这里不是装饰：它把 PostProcessor 的作用域**限定**在
               本 Include 引入的 sampler 上。若把 PostProcessor 直接放在 TX 层，
               按 JMeter 作用域规则它会作用到 TX 下**全部** sampler（含 counterparties），
               于是 pick-portfolio 会拿 counterparties 的响应去解析 —— 静默出错。 -->
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="portfolios" enabled="true"/>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include portfolios-list" enabled="true">
              <stringProp name="IncludeController.includepath">jmx/fragments/steps/refdata/portfolios-list.jmx</stringProp>
            </IncludeController>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="pick one portfolio" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/refdata-pick-portfolio.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>

          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="counterparties" enabled="true"/>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="include counterparties-list" enabled="true">
              <stringProp name="IncludeController.includepath">jmx/fragments/steps/refdata/counterparties-list.jmx</stringProp>
            </IncludeController>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="pick one counterparty (paired)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/refdata-pick-counterparty.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>

        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
