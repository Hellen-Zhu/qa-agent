<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/steps/workers/checker-flow/approve-task.jmx

  【层级】原子 fragment —— 一个 API 一个文件，不可独立运行
  【API】  workers.checker-flow.approve  ·  POST /checker/tasks/{taskId}/approve
  【服务】 workers  →  必须使用 ${__P(workers.*)} 寻址（校验规则 R3）

  ⚠⚠ 请求体形状为**推断值，未经真实 curl 验证** ⚠⚠
     本工程只拿到了 create 的真实 curl。approve 的 body 目前假设为
     可选的 {"comment": "..."}；也可能是空体、或需要版本号做乐观锁。
     构造集中在 groovy/checker-claim-task.groovy 一处，确认后只改那里。
     错的表现：HTTP 400 或业务拒绝 —— 会被 errClass 归为 technical/business，
     不会静默通过。

  ══ 这是两阶段写路径的后半段 ══════════════════════════════════
  maker 提交 → trade 锁定 pending approve → 写 checker_tasks → 通知 → 存 snapshot
                          ↓  人工间隔（分钟~小时级，**不属于任何事务**）
  本 fragment：checker approve → 事件执行 → 状态更新 → 发确认

  【硬规则】TX_workers_checkerflow_approve 与 create 的事务**禁止相加**或拼成
  一个端到端事务。中间的间隔由人决定，拼出来的数字主要反映 checker 什么时候
  去吃饭。两者分别计时、分别设 SLA（NFR PERF-12 / PERF-13）。
  ═══════════════════════════════════════════════════════════════

  ══ Fragment 契约 ══════════════════════════════════════════════
  【输入】claimedTaskId —— 由内部的 checker-claim-task.groovy 从 claim-once 池取出
         userId       —— checker 身份（注意不能与 maker 相同，见 NFR SEC-02）
  【输出】errClass = ok | technical | business | script
  【产出事务】TX_workers_checkerflow_approve
  ═══════════════════════════════════════════════════════════════
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="workers.checker-flow.approve (fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Atomic fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="workers.checker-flow.approve" enabled="true"/>
      <hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_workers_checkerflow_approve" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="workers_checkerflow_approve" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${checkerPayload}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${__P(workers.host,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(workers.port,8080)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(workers.protocol,http)}</stringProp>
            <stringProp name="HTTPSampler.path">${__P(workers.basePath,/api/v1)}/checker/tasks/${claimedTaskId}/approve</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          </HTTPSamplerProxy>
          <hashTree>

            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="claim one task (claim-once)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/checker-claim-task.groovy</stringProp>
              <stringProp name="parameters">approve</stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>

            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="json content-type" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>

            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="http 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>

            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="business status + error class" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/assert-checker-response.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>

          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
