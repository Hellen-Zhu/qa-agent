<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/steps/workers/checker-flow/bulk-approve.jmx

  【层级】原子 fragment —— 一个 API 一个文件，不可独立运行
  【API】  workers.checker-flow.bulk-approve  ·  POST /checker/tasks/bulk-approve
  【服务】 workers  →  必须使用 ${__P(workers.*)} 寻址（校验规则 R3）
  【优先级】P0

  ⚠⚠ 请求体形状为**推断值，未经真实 curl 验证** ⚠⚠
     假设 {"taskIds": ["CHK-...", ...]}。构造集中在
     groovy/checker-claim-batch.groovy 一处，确认后只改那里。

  ══ 为什么 bulk-approve 是 P0 ═════════════════════════════════
  这个接口的**存在本身**就是业务事实：checker 是批量作业的。
  Workload Modeling §7 因此把"checker 批量清队列"列为 OREO 四个峰值成因之一，
  且它的形态很特殊 —— 不是"每秒 N 笔"，而是"一个人在 30 秒内点掉 20 笔"。

  **用恒定到达率打量测不出它的真实行为。** 风险点是
  **单请求内含 N 笔的事务边界与锁范围**，不是请求速率。
  ═══════════════════════════════════════════════════════════════

  ══ 批次大小是一等变量（NFR PERF-16）═══════════════════════════
  必须在多个批次大小下测（1 / 5 / 20 / 50），判断单位工作量耗时的走向：

    单位耗时恒定        线性，健康。批量只省了网络往返
    单位耗时随批次下降  有批量优化（如批量 SQL），健康
    单位耗时随批次上升  **超线性成本**（锁范围扩大 / 事务过长 / 内存累积）
                        → 批次必须设上限，这是架构约束不是调优问题

  **"不随批次增大而上升"比绝对值更重要。**

  跑法：./scripts/run.sh p03-checker-bulk-approve perf load -JcheckerBatchSize=20
  结果里 claimedCount 一列是真实分母（池不足时会小于 checkerBatchSize）。
  ═══════════════════════════════════════════════════════════════

  ══ Fragment 契约 ══════════════════════════════════════════════
  【输入属性】checkerBatchSize  默认 20（Workload Modeling A9）
  【输入变量】userId —— checker 身份
  【输出变量】claimedCount —— 本次实际取到的任务数，单位工作量耗时的分母
             errClass = ok | technical | business | script
  【产出事务】TX_workers_checkerflow_bulkapprove
  ═══════════════════════════════════════════════════════════════
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="workers.checker-flow.bulk-approve (fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Atomic fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="workers.checker-flow.bulk-approve" enabled="true"/>
      <hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_workers_checkerflow_bulkapprove" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="workers_checkerflow_bulkapprove" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${checkerBulkPayload}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${__P(workers.host,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(workers.port,8080)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(workers.protocol,http)}</stringProp>
            <stringProp name="HTTPSampler.path">${__P(workers.basePath,/api/v1)}/checker/tasks/bulk-approve</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
