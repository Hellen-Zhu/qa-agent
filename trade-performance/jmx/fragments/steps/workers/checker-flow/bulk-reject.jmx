<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/steps/workers/checker-flow/bulk-reject.jmx

  【层级】原子 fragment —— 一个 API 一个文件，不可独立运行
  【API】  workers.checker-flow.bulk-reject  ·  POST /checker/tasks/bulk-reject
  【服务】 workers  →  必须使用 ${__P(workers.*)} 寻址（校验规则 R3）
  【优先级】P0

  ⚠⚠ 请求体形状为**推断值，未经真实 curl 验证** ⚠⚠
     假设 {"taskIds": [...], "reason": "..."}。**reason 必填**有业务依据
     （NFR AUDIT-04：拒绝原因必须记录且不可为空）。
     构造集中在 groovy/checker-claim-batch.groovy。

  ══ 这是本组里成本最高的一个接口 ═══════════════════════════════
  它把两个放大因子叠在一起：
    批量        一次请求处理 N 笔
    reject 路径 每笔都要做 snapshot 恢复 + 审计写入

  所以 **N 笔 bulk-reject ≠ N 笔 bulk-approve 的耗时**。
  只测 bulk-approve 会低估审批链路在最坏情况下的成本。

  单位工作量耗时的走向在这里尤其值得看：如果 snapshot 恢复是逐笔串行的，
  单位耗时会随批次上升 —— 那意味着"一次拒绝一批"在生产里会长时间持有事务。
  ═══════════════════════════════════════════════════════════════

  ══ Fragment 契约 ══════════════════════════════════════════════
  【输入属性】checkerBatchSize   默认 20
             checkerRejectReason 默认 "PERF TEST rejection"
  【输入变量】userId —— checker 身份
  【输出变量】claimedCount · errClass
  【产出事务】TX_workers_checkerflow_bulkreject
  ═══════════════════════════════════════════════════════════════
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="workers.checker-flow.bulk-reject (fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Atomic fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="workers.checker-flow.bulk-reject" enabled="true"/>
      <hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_workers_checkerflow_bulkreject" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="workers_checkerflow_bulkreject" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${checkerBulkPayload}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${__P(workers.host,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(workers.port,8080)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(workers.protocol,http)}</stringProp>
            <stringProp name="HTTPSampler.path">${__P(workers.basePath,/api/v1)}/checker/tasks/bulk-reject</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          </HTTPSamplerProxy>
          <hashTree>

            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="claim batch (claim-once)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/checker-claim-batch.groovy</stringProp>
              <stringProp name="parameters">reject</stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>

            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="json content-type" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>

            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="http 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>

            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="business status + partial-failure check" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/assert-checker-bulk-response.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>

          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
