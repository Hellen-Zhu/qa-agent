<?xml version="1.0" encoding="UTF-8"?>
<!--
  fragments/steps/workers/trade-management/trades-list.jmx

  【层级】原子 fragment —— 一个 API 一个文件，不可独立运行
  【API】  workers.trade-management.list  ·  GET /trades
  【服务】 workers  →  必须使用 ${__P(workers.*)} 寻址（校验规则 R3）
  【优先级】P0

  ══ 这是全系统请求量最大的路径 ═══════════════════════════════════
  Trade Portal 单页含**多个 blotter**，每个是一次独立列表查询，且会自动刷新：

    稳态列表查询 TPS = 并发用户数 × 每页 blotter 数(A10) ÷ 自动刷新间隔(A11)
                     = 31 × 4 ÷ 30 ≈ 4.13 TPS 恒定

  按 Workload Modeling §1，它与通知轮询合计约占系统请求总量的 **97%**，
  远超真实业务负载。设计容量 33 TPS（§6）。
  ═══════════════════════════════════════════════════════════════

  ══ 为什么"blotter 列表"和"按 ref 定位"是同一个 fragment ══════════
  校验规则 R2 在查重时会剥掉 query string，两者都归一为 `GET /trades`，
  因此**规则强制它们共用一份契约**。这是对的：它们是同一个端点、同一份契约，
  差异只是查询参数。用法差异由变量表达，不由复制文件表达。

    blotter 列表   size=200（A17）
    按 ref 定位    search=<tradeReference>
    数据量伸缩     size=50 / 200 / 500（S-09 / S-10 的扫描维度）

  查询串由内部的 build-trades-query.groovy 构造，调用方在 Include 前设变量即可。
  ═══════════════════════════════════════════════════════════════

  ⚠ 本接口走 checker enrich 路径 → **UC gRPC**（依赖影响面第一，9 个接口共用）。
    若富化是逐行 N+1，33 TPS 的列表 = 6,600 QPS 的 gRPC —— 这是唯一能让 OREO
    达到三位数 QPS 的路径，也是 S-09 扇出审计的被测对象。
    在 S-09 出结论之前，PERF-02 的 1,500ms 阈值只是一个数字。

  ══ Fragment 契约 ══════════════════════════════════════════════
  【输入变量】tradesSearch  可选 —— 设了就走 search 定位，不设走 blotter 列表
  【输入属性】blotterPageSize 默认 200（A17）
  【输出变量】tradesQuery —— 实际发出的查询串，进 jtl 便于事后归因
  【产出事务】TX_workers_trademgmt_list
  ═══════════════════════════════════════════════════════════════
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="workers.trade-management.list (fragment)" enabled="true">
      <stringProp name="TestPlan.comments">Atomic fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="workers.trade-management.list" enabled="true"/>
      <hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_workers_trademgmt_list" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="workers_trademgmt_list" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${__P(workers.host,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(workers.port,8080)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(workers.protocol,http)}</stringProp>
            <stringProp name="HTTPSampler.path">${__P(workers.basePath,/api/v1)}/trades?${tradesQuery}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          </HTTPSamplerProxy>
          <hashTree>

            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="build query" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/build-trades-query.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>

            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="http 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">GET /trades did not return 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>

            <!-- 返回行数是数据量伸缩性与扇出审计的关键自变量，必须进 jtl。
                 只记 P95 而不记行数的列表接口数据无法解读：
                 "P95 = 1.2s" 在返回 50 行和 500 行时含义完全不同。 -->
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="record row count" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename">${__P(baseDir,.)}/groovy/trades-record-rowcount.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>

          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
