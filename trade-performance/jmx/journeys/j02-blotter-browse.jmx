<?xml version="1.0" encoding="UTF-8"?>
<!--
  journeys/j02-blotter-browse.jmx

  【层级】journey —— 不可运行（Test Fragment，无 Thread Group）
  【被谁引用】scenarios/s02-blotter-browse-e2e.jmx
  【测什么】Trade Portal 的常态负载：打开页面 → N 个 blotter 各查一次 → 看一笔详情

  ══ 这是 OREO 请求量最大的链路，不是最重要的业务链路 ═══════════════
  按 Workload Modeling §1，blotter 自动刷新 + 通知轮询约占系统请求总量的 **97%**，
  而真实业务负载（booking + lifecycle event）只占不到 1%。

  所以这条 journey 的价值不在于"业务重要"，而在于它是**系统实际承受的负载**。
  只测 create 而不测 blotter，等于测了 1% 的流量然后下容量结论。
  ═══════════════════════════════════════════════════════════════

  ══ Loop Controller 的循环次数直接编码 A10 ═════════════════════
  单页 blotter 数（A10，v0=4）是 OREO 最大的单一容量变量：

    稳态列表查询 TPS = 并发用户数 × A10 ÷ A11(自动刷新间隔)

  这里用 ${__P(blottersPerPage,4)} 驱动循环，改假设只需改属性，不改脚本。
  **A10 与 A11 是前端配置项、不是业务约束** —— 确认成本极低、容量收益极高，
  是整个模型里最该优先确认的一组假设（Workload Modeling §4.4）。
  ═══════════════════════════════════════════════════════════════

  ⚠ 本 journey 模拟的是**用户主动打开页面**（0.14 TPS）。
    真正的大头是**自动刷新**（4.13 TPS 恒定），它与用户行为无关 ——
    那部分应由独立的常驻负载线程组施加，见 suites/（尚未建）。
    只跑本 journey 会低估 blotter 的真实负载约 30 倍。

  【输入属性】blottersPerPage 默认 4（A10）· blotterPageSize 默认 200（A17）
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="j02-blotter-browse (journey)" enabled="true">
      <stringProp name="TestPlan.comments">Journey fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="j02-blotter-browse" enabled="true"/>
      <hashTree>

        <!-- ── 1. 打开 Portal：N 个 blotter 各查一次 ──────────────── -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX_flow_portal_open" enabled="true">
          <boolProp name="TransactionController.parent">false</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="blotters per page (A10)" enabled="true">
            <boolProp name="LoopController.continue_forever">false</boolProp>
            <stringProp name="LoopController.loops">${__P(blottersPerPage,4)}</stringProp>
          </LoopController>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: trades-list" enabled="true">
              <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/trades-list.jmx</stringProp>
            </IncludeController>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ── 2. 用户扫一眼列表 ──────────────────────────────────── -->
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="think: scan the blotter" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="3~8s" enabled="true">
            <stringProp name="ConstantTimer.delay">3000</stringProp>
            <stringProp name="RandomTimer.range">5000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- ── 3. 挑一笔看详情（右键 View Details，菜单里频率最高的一项）── -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="pick a trade" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: trades-list (pick target)" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/trades-list.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="pick one trade" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/trades-pick-one.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <!-- view-trade-details 需要 tradeId 变量名，与本 journey 的 targetTradeId 对齐 -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="alias targetTradeId -> tradeId" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">${__P(baseDir,.)}/groovy/alias-target-trade-id.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: view-trade-details" enabled="true">
          <stringProp name="IncludeController.includepath">jmx/fragments/steps/_composites/view-trade-details.jmx</stringProp>
        </IncludeController>
        <hashTree/>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
