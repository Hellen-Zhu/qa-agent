<?xml version="1.0" encoding="UTF-8"?>
<!--
  journeys/j03-checker-approve.jmx

  【层级】journey —— 不可运行（Test Fragment，无 Thread Group）
  【被谁引用】scenarios/s03-checker-approve-e2e.jmx
  【测什么】checker 侧的完整动作：打开待办列表 → 阅读 → 审批或拒绝

  ══ 这是两阶段写路径的后半段，必须与 maker 侧分开计时 ═══════════════
    maker 提交（j01 / TX_workers_trademgmt_create）
        ↓  人工间隔：分钟~小时级 —— **不属于任何事务**
    本 journey（TX_workers_checkerflow_approve / _reject）

  两者禁止拼成一个端到端事务：中间的间隔由人决定，拼出来的数字主要反映
  checker 什么时候去吃饭。分别设 SLA，见 NFR PERF-12 / PERF-13 / PERF-14。

  【Time-to-Approve】maker 提交 → checker 完成 这个业务指标仍需观测，
  但它属于**业务流程效率**（checker 团队处理能力是否跟得上），不是系统 SLA。
  见 KPI Definitions §2.1。
  ═══════════════════════════════════════════════════════════════

  ══ 链路 ══════════════════════════════════════════════════════
    1. 打开待办列表                       [TX_workers_checkerflow_pending]
         ↓ think 2~5s（checker 要读一下这笔 trade 才能决定）
    2. 抽签：5% reject / 95% approve      （A8，见 checker-pick-action.groovy）
         ├── approve                      [TX_workers_checkerflow_approve]
         └── reject                       [TX_workers_checkerflow_reject]
  ═══════════════════════════════════════════════════════════════

  ⚠ taskId **不从第 1 步的响应里取**，而是从 setUp 建好的 claim-once 池里领。
    多个 checker 线程读到的是同一批待办，各自从响应里挑必然撞车 ——
    第二个线程会拿到已被处理的 task，服务端业务拒绝，报告里表现为
    "错误率 X%、无规律"。这是绑定时机问题，与 refdata 同一个道理。
    领取逻辑在 groovy/checker-claim-task.groovy（原子 fragment 内部）。

  【输入】setUp 必须已执行 fragments/setup/checker-task-pool.jmx
  【输入属性】checkerRejectRate 默认 5（%）
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="j03-checker-approve (journey)" enabled="true">
      <stringProp name="TestPlan.comments">Journey fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="j03-checker-approve" enabled="true"/>
      <hashTree>

        <!-- ── 1. 打开待办列表 ─────────────────────────────────────── -->
        <!-- Simple Controller 限定 PostProcessor 的作用域到本 Include 的 sampler -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="pending" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: pending-tasks" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/checker-flow/pending-tasks.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="pick action (approve|reject)" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/checker-pick-action.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <!-- ── think time：checker 要读一下这笔 trade 才能决定 ──────── -->
        <!-- Flow Control Action + Timer：JMeter 的 Timer 按**作用域**生效而不是按
             位置顺序。想在两步之间插停顿，唯一可靠的做法是给一个空动作挂 Timer。
             直接把 Timer 放在两个 Include 之间，它会作用到整个作用域内的所有
             sampler，变成"每个请求前都等 2~5 秒"。 -->
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="think: read the trade" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="2~5s" enabled="true">
            <stringProp name="ConstantTimer.delay">2000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- ── 2a. approve（约 95%）───────────────────────────────── -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if approve" enabled="true">
          <stringProp name="IfController.condition">${__jexl3("${checkerAction}" == "approve")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: approve-task" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/checker-flow/approve-task.jmx</stringProp>
          </IncludeController>
          <hashTree/>
        </hashTree>

        <!-- ── 2b. reject（约 5%，A8）─────────────────────────────── -->
        <!-- 这条路径更贵：snapshot 恢复 + 审计写入。只压 approve 会系统性
             低估审批链路成本，所以它必须在 journey 里真实出现，而不是"以后再说"。 -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if reject" enabled="true">
          <stringProp name="IfController.condition">${__jexl3("${checkerAction}" == "reject")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: reject-task" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/checker-flow/reject-task.jmx</stringProp>
          </IncludeController>
          <hashTree/>
        </hashTree>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
