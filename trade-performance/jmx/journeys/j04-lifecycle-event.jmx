<?xml version="1.0" encoding="UTF-8"?>
<!--
  journeys/j04-lifecycle-event.jmx

  【层级】journey —— 不可运行（Test Fragment，无 Thread Group）
  【被谁引用】scenarios/s04-lifecycle-event-e2e.jmx
  【测什么】右键生命周期事件的完整链路：blotter 选中 → 风险预览 → 提交事件

  ══ 链路 ══════════════════════════════════════════════════════
    1. blotter 列表 → 随机挑一笔       [TX_workers_trademgmt_list]
         ↓ think 3~8s（用户找到目标那笔）
    2. 风险预览（按事件类型分流）
         ├── PartialNovation → 部分转让风险  [TX_..._calcpartialnovationrisk]
         └── 其余            → 常规风险      [TX_..._calcrisk]
         ↓ think 2~5s（看完风险再决定）
    3. 提交事件                        [TX_workers_trademgmt_triggerevent]
  ═══════════════════════════════════════════════════════════════

  ══ 这条链路是两阶段写路径的**起点** ═══════════════════════════
  事件提交后的走向由 CSV 的 needsApproval 决定：

    true （Cancellation）  → trade 锁 pending approve → 写 checker_tasks
                            后半段在 j03-checker-approve
    false（其余 8 种）      → 直接执行，链路到此结束

  两者的耗时与资源占用完全不同，报告必须按 needsApproval 分开看。
  ⚠ "暂不需审批"是过渡状态（背景用词是 not yet），迁移时只改 CSV 的那一列。
  ═══════════════════════════════════════════════════════════════

  ⚠ 多线程可能挑中同一笔 trade。第二个提交会因 trade 已处于 pending approve
    被业务拒绝 —— 这是四眼原则的**正确行为**，不是缺陷。
    assert-trigger-event-response.groovy 把它单列为 lockedRejection。
    该比例过高说明**可挑的 trade 太少**（数据池问题），不是系统问题。
    S-05 同实体争用场景则反过来刻意制造这种碰撞。

  【输入】CSV: data/lifecycle-events/lifecycle-event-data.csv
         提供 eventCaseId / eventType / needsApproval / partialPct
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="j04-lifecycle-event (journey)" enabled="true">
      <stringProp name="TestPlan.comments">Journey fragment. Never run directly.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="j04-lifecycle-event" enabled="true"/>
      <hashTree>

        <!-- ── 1. blotter 列表 → 挑一笔 ───────────────────────────── -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="blotter" enabled="true"/>
        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: trades-list" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/trades-list.jmx</stringProp>
          </IncludeController>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="pick one trade" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">${__P(baseDir,.)}/groovy/trades-pick-one.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="think: locate the trade" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="3~8s" enabled="true">
            <stringProp name="ConstantTimer.delay">3000</stringProp>
            <stringProp name="RandomTimer.range">5000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- ── 2. 风险预览：只在挑到 trade 时执行 ──────────────────── -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if trade picked" enabled="true">
          <stringProp name="IfController.condition">${__jexl3("${targetTradeId}" != "NOT_FOUND")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>

          <!-- 部分转让有专门的风险预览接口（需要按比例重算剩余名义本金） -->
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if PartialNovation" enabled="true">
            <stringProp name="IfController.condition">${__jexl3("${eventType}" == "PartialNovation")}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: calc-partial-novation-risk" enabled="true">
              <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/calc-partial-novation-risk.jmx</stringProp>
            </IncludeController>
            <hashTree/>
          </hashTree>

          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if not PartialNovation" enabled="true">
            <stringProp name="IfController.condition">${__jexl3("${eventType}" != "PartialNovation")}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: calculate-risk" enabled="true">
              <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/calculate-risk.jmx</stringProp>
            </IncludeController>
            <hashTree/>
          </hashTree>

          <TestAction guiclass="TestActionGui" testclass="TestAction" testname="think: review risk" enabled="true">
            <intProp name="ActionProcessor.action">1</intProp>
            <intProp name="ActionProcessor.target">0</intProp>
            <stringProp name="ActionProcessor.duration">0</stringProp>
          </TestAction>
          <hashTree>
            <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="2~5s" enabled="true">
              <stringProp name="ConstantTimer.delay">2000</stringProp>
              <stringProp name="RandomTimer.range">3000</stringProp>
            </UniformRandomTimer>
            <hashTree/>
          </hashTree>

          <!-- ── 3. 提交事件 ─────────────────────────────────────── -->
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="inc: trigger-event" enabled="true">
            <stringProp name="IncludeController.includepath">jmx/fragments/steps/workers/trade-management/trigger-event.jmx</stringProp>
          </IncludeController>
          <hashTree/>

        </hashTree>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
